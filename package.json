{
  "name": "holamaatu",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@advisor/app && node scripts/copy-dist.js",
    "build:mobile": "npm run build && cd packages/app && npx cap sync android && cd android && gradlew.bat assembleDebug --no-daemon && copy .\\app\\build\\outputs\\apk\\debug\\app-debug.apk ..\\..\\..\\Holamaatu.apk",
    "open:android": "cd packages/app && npx cap open android",
    "install:phone": "adb install -r Holamaatu.apk",
    "test": "vitest run",
    "lint": "eslint .",
    "ask": "npx tsx packages/app/src/cli.ts",
    "validate-kb": "tsx scripts/validate-kb.ts",
    "license-audit": "tsx scripts/license-audit.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "dependencies": {
    "onnxruntime-web": "^1.27.0"
  }
}
